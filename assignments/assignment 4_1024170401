    "    filtered_df = df[df['category'] == category_name][['question', 'answer', 'category']]\n",
    "    return filtered_df\n",
    "\nselected_category = \"billing\"\nprint(f\"All FAQ entries in '{selected_category}' category:\")\nprint(same_category(selected_category, df))"
